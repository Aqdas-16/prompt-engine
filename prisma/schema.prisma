generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Subscription {
  id                String   @id @default(uuid())
  userId            String
  plan              String
  billingCycle      String
  status            String
  startDate         DateTime @default(now())
  endDate           DateTime
  razorpayPaymentId String?
  createdAt         DateTime @default(now())
  razorpayOrderId   String?
  user              User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model User {
  id                 String          @id @default(uuid())
  email              String          @unique
  plan               String          @default("free")
  usageCount         Int             @default(0)
  createdAt          DateTime        @default(now())
  planStartDate      DateTime        @default(now())
  advancedUsageCount Int             @default(0)
  billingCycle       String          @default("monthly")
  lastOrderId        String?
  lastPaymentId      String?
  name               String?
  normalUsageCount   Int             @default(0)
  paymentMethod      String?
  paymentStatus      String?
  isCounted          Boolean         @default(false)
  firebaseUid        String          @unique
  photoURL           String?
  prompts            Prompt[]
  promptHistory      PromptHistory[]
  subscriptions      Subscription[]
  templates          Template[]
}

model PromptHistory {
  id        String   @id @default(uuid())
  userId    String
  input     String
  output    String
  mode      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Template {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String
  tag       String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Payment {
  id                String   @id @default(uuid())
  userId            String
  email             String
  plan              String
  billingCycle      String
  amount            Int
  razorpayOrderId   String
  razorpayPaymentId String
  razorpaySignature String
  status            String
  createdAt         DateTime @default(now())
}

model Counter {
  id               String @id @default("global")
  promptsGenerated Int    @default(0)
  usersCount       Int    @default(0)
}

model Prompt {
  id               String   @id @default(uuid())
  userId           String
  user_input       String
  generated_prompt String
  mode             String
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id])

  @@index([userId])
}
